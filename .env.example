# POSIND Automation Environment Configuration Example
# Copy this file to .env and configure credentials securely without committing to version control.

# Generic OMS Credentials (overrides both Staging and Smart Routing if set)
# OMS_USERNAME=your_oms_email@example.com
# OMS_PASSWORD=your_oms_password_here

# Environment-Specific OMS Credentials
# OMS_STAGING_USERNAME=your_staging_email@example.com
# OMS_STAGING_PASSWORD=your_staging_password_here

# OMS_SMARTROUTING_USERNAME=your_smartrouting_email@example.com
# OMS_SMARTROUTING_PASSWORD=your_smartrouting_password_here

# VMS Credentials
# VMS_USERNAME=your_vms_email@example.com
# VMS_PASSWORD=your_vms_password_here

# Execution Settings
# HEADLESS=false
# BATCH_CONCURRENCY=3
