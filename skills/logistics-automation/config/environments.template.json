{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "environments": {
    "staging-posind-core": {
      "name": "staging-posind-core",
      "description": "Primary staging web interface for core logistics operations.",
      "applicationUrl": "https://staging-app.example.internal",
      "defaultAccount": "ops-admin",
      "accounts": {
        "ops-admin": {
          "accountId": "ops-admin",
          "displayName": "Operations Admin",
          "loginMethod": "standard-ui-form",
          "loginUrl": "/login",
          "credentialRef": {
            "type": "env",
            "usernameVar": "POSIND_STAGING_USERNAME",
            "passwordVar": "POSIND_STAGING_PASSWORD"
          },
          "roles": ["order_creator", "catalog_manager"]
        },
        "dispatcher-user": {
          "accountId": "dispatcher-user",
          "displayName": "Dispatch Staff",
          "loginMethod": "sso-ui-redirect",
          "loginUrl": "/auth/sso",
          "credentialRef": {
            "type": "env",
            "usernameVar": "POSIND_DISPATCH_USERNAME",
            "passwordVar": "POSIND_DISPATCH_PASSWORD"
          },
          "roles": ["order_creator"]
        }
      },
      "supportedWorkflows": [
        "order-creation",
        "service-catalog-creation"
      ],
      "environmentSpecificConfig": {
        "browser": {
          "headless": true,
          "slowMo": 0,
          "viewport": {
            "width": 1280,
            "height": 800
          },
          "navigationTimeoutMs": 30000,
          "actionTimeoutMs": 10000
        },
        "sessionPersistence": {
          "enabled": true,
          "storageStateDir": ".sessions"
        },
        "flags": {
          "strictRouteValidation": true
        }
      }
    },
    "uat-posind-partner": {
      "name": "uat-posind-partner",
      "description": "UAT web portal for partner logistics workflows.",
      "applicationUrl": "https://uat-app.example.internal",
      "defaultAccount": "uat-partner-admin",
      "accounts": {
        "uat-partner-admin": {
          "accountId": "uat-partner-admin",
          "displayName": "Partner Admin UAT",
          "loginMethod": "standard-ui-form",
          "loginUrl": "/portal/login",
          "credentialRef": {
            "type": "env",
            "usernameVar": "POSIND_UAT_USERNAME",
            "passwordVar": "POSIND_UAT_PASSWORD"
          },
          "roles": ["order_creator", "catalog_manager"]
        }
      },
      "supportedWorkflows": [
        "order-creation"
      ],
      "environmentSpecificConfig": {
        "browser": {
          "headless": true,
          "slowMo": 0,
          "viewport": {
            "width": 1280,
            "height": 800
          },
          "navigationTimeoutMs": 45000,
          "actionTimeoutMs": 15000
        },
        "sessionPersistence": {
          "enabled": true,
          "storageStateDir": ".sessions"
        },
        "flags": {
          "strictRouteValidation": false
        }
      }
    }
  }
}
